# Copy to .env and set the SQL Server sa, read-only logibooks, and tool writer passwords.
MSSQL_SA_PASSWORD=
ALTA_DB_PASSWORD=
ALTA_DEV_WRITER_PASSWORD=
ALTA_DEV_BASELINE_BAK=D:/Projects/logibooks/AltaDB/development/reestr_1-dev.bak
MSSQL_PORT=1433
ADMINER_PORT=8083

# The full Compose stack mounts the existing Logibooks PostgreSQL cluster.
# LOGIBOOKS_CORE_PGDATA=../.pgdata
# LOGIBOOKS_CORE_DIR=../core
# LOGIBOOKS_UI_DIR=../ui
# Optional: pause Alta monitoring in the full Compose stack.
# ALTA_TEST_MONITORING=false
# ALTA_TEST_MONITORING_CRON='0/15 * * * * ?'

# Optional Core worklist credentials for an account with the adapter-alta role.
# Core__Enabled=true
# Core__Email=alta@example.test
# Core__Password='replace-me'

